{
  "name": "dsh-hindsight-local",
  "version": "0.2.0",
  "description": "Local Hindsight memory for DeepSeek Harness: memory server on your own machine, your own LLM key, plus a session-end handoff snapshot that the next session picks up.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/",
    "scripts/smoke.mjs",
    "scripts/hooks-test.mjs",
    "scripts/handoff-check.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "icon.svg",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "hindsight",
    "memory",
    "local-first"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.1.0-rc.6",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node scripts/hooks-test.mjs && node scripts/smoke.mjs",
    "smoke": "node scripts/smoke.mjs"
  }
}
